<mujoco model="phase0_frictional_panel">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" iterations="100" tolerance="1e-10"/>
  <extension><plugin plugin="mujoco.sensor.touch_grid"/></extension>
  <default>
    <geom friction="1 0.005 0.0001" condim="3" solref="0.01 1" solimp="0.95 0.99 0.001"/>
  </default>
  <worldbody>
    <light pos="0 -1 3"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba=".15 .18 .22 1" contype="4" conaffinity="2"/>
    <body name="wrist" pos="-0.25 0 0.8">
      <joint name="wrist_pitch" type="hinge" axis="0 1 0" damping="0.8" stiffness="1" limited="true" range="-0.7 0.7"/>
      <geom name="fixture" type="box" pos="-0.065 0 0" size=".015 .09 .08" mass="0.3" contype="0" conaffinity="0" rgba=".3 .35 .4 1"/>
      <site name="wrist_origin" size="0.005"/>
      <body name="upper" pos="0 0 .02">
        <joint name="upper_slide" type="slide" axis="0 0 1" damping="20" armature="0.02" limited="true" range="-.006 .015"/>
        <geom name="upper_pad" type="box" size=".045 .07 .01" mass=".1" contype="1" conaffinity="2" rgba=".2 .6 .9 1"/>
        <site name="upper_touch" pos="0 0 .08" size=".003"/>
      </body>
      <body name="lower" pos="0 0 -.02">
        <joint name="lower_slide" type="slide" axis="0 0 1" damping="20" armature="0.02" limited="true" range="-.015 .006"/>
        <geom name="lower_pad" type="box" size=".045 .07 .01" mass=".1" contype="1" conaffinity="2" rgba=".2 .6 .9 1"/>
        <site name="lower_touch" pos="0 0 -.08" quat="0 1 0 0" size=".003"/>
      </body>
    </body>
    <body name="panel" pos="0 0 .8">
      <freejoint name="panel_free"/>
      <geom name="panel_geom" type="box" size=".3 .1 .01" mass="1" contype="2" conaffinity="5" rgba=".85 .65 .25 1"/>
      <site name="human_grasp" pos=".27 0 0" size=".012" rgba=".9 .3 .3 1"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="upper_preload" joint="upper_slide" ctrllimited="true" ctrlrange="-80 0"/>
    <motor name="lower_preload" joint="lower_slide" ctrllimited="true" ctrlrange="0 80"/>
  </actuator>
  <sensor>
    <plugin name="upper_grid" plugin="mujoco.sensor.touch_grid" objtype="site" objname="upper_touch">
      <config key="nchannel" value="3"/><config key="size" value="4 4"/><config key="fov" value="110 85"/><config key="gamma" value="0"/>
    </plugin>
    <plugin name="lower_grid" plugin="mujoco.sensor.touch_grid" objtype="site" objname="lower_touch">
      <config key="nchannel" value="3"/><config key="size" value="4 4"/><config key="fov" value="110 85"/><config key="gamma" value="0"/>
    </plugin>
  </sensor>
</mujoco>
