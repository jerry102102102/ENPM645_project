<mujoco model="dual_gripper_v2">
  <compiler angle="radian" />
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" iterations="100" tolerance="1e-10" />
  <extension>
    <plugin plugin="mujoco.sensor.touch_grid" />
  </extension>
  <default>
    <geom friction="1 0.005 0.0001" condim="3" solref="0.01 1" solimp="0.95 0.99 0.001" />
  </default>
  <worldbody>
    <light pos="0 -1 3" diffuse=".9 .9 .9" ambient=".3 .3 .3" />
    <geom name="floor" type="plane" size="2 2 .1" rgba=".15 .18 .22 1" contype="4" conaffinity="2" />
    <body name="left" pos="-0.2 0 .8">
      <freejoint name="left_free" />
      <geom name="left_flange" type="box" pos="0 .095 0" size=".05 .015 .05" mass=".3" contype="0" conaffinity="0" rgba=".3 .35 .4 1" />
      <body name="left_upper" pos="0 0 0.02">
        <joint name="left_upper_slide" type="slide" axis="0 0 1" damping="20" armature=".02" limited="true" range="-.006 .015" />
        <geom name="left_upper_pad" type="box" size=".045 .07 .01" mass=".1" contype="1" conaffinity="2" rgba=".2 .6 .9 1" />
        <site name="left_upper_touch" pos="0 0 0.08" quat="1 0 0 0" size=".003" rgba="0 0 0 0" />
      </body>
      <body name="left_lower" pos="0 0 -0.02">
        <joint name="left_lower_slide" type="slide" axis="0 0 1" damping="20" armature=".02" limited="true" range="-.015 .006" />
        <geom name="left_lower_pad" type="box" size=".045 .07 .01" mass=".1" contype="1" conaffinity="2" rgba=".2 .6 .9 1" />
        <site name="left_lower_touch" pos="0 0 -0.08" quat="0 1 0 0" size=".003" rgba="0 0 0 0" />
      </body>
    </body>
    <body name="right" pos="0.2 0 .8">
      <freejoint name="right_free" />
      <geom name="right_flange" type="box" pos="0 .095 0" size=".05 .015 .05" mass=".3" contype="0" conaffinity="0" rgba=".3 .35 .4 1" />
      <body name="right_upper" pos="0 0 0.02">
        <joint name="right_upper_slide" type="slide" axis="0 0 1" damping="20" armature=".02" limited="true" range="-.006 .015" />
        <geom name="right_upper_pad" type="box" size=".045 .07 .01" mass=".1" contype="8" conaffinity="2" rgba=".6 .3 .8 1" />
        <site name="right_upper_touch" pos="0 0 0.08" quat="1 0 0 0" size=".003" rgba="0 0 0 0" />
      </body>
      <body name="right_lower" pos="0 0 -0.02">
        <joint name="right_lower_slide" type="slide" axis="0 0 1" damping="20" armature=".02" limited="true" range="-.015 .006" />
        <geom name="right_lower_pad" type="box" size=".045 .07 .01" mass=".1" contype="8" conaffinity="2" rgba=".6 .3 .8 1" />
        <site name="right_lower_touch" pos="0 0 -0.08" quat="0 1 0 0" size=".003" rgba="0 0 0 0" />
      </body>
    </body>
    <body name="panel" pos="0 0 .8">
      <freejoint name="panel_free" />
      <geom name="panel_geom" type="box" size=".3 .1 .01" mass="1" contype="2" conaffinity="13" rgba=".85 .65 .25 1" />
      <site name="human_grasp" pos=".27 -.08 0" size=".012" rgba=".9 .3 .3 1" />
    </body>
  </worldbody>
  <actuator>
    <motor name="left_upper_preload" joint="left_upper_slide" ctrllimited="true" ctrlrange="-80 0" />
    <motor name="left_lower_preload" joint="left_lower_slide" ctrllimited="true" ctrlrange="0 80" />
    <motor name="right_upper_preload" joint="right_upper_slide" ctrllimited="true" ctrlrange="-80 0" />
    <motor name="right_lower_preload" joint="right_lower_slide" ctrllimited="true" ctrlrange="0 80" />
  </actuator>
  <sensor>
    <plugin name="left_upper_grid" plugin="mujoco.sensor.touch_grid" objtype="site" objname="left_upper_touch">
      <config key="nchannel" value="3" />
      <config key="size" value="4 4" />
      <config key="fov" value="110 85" />
      <config key="gamma" value="0" />
    </plugin>
    <plugin name="left_lower_grid" plugin="mujoco.sensor.touch_grid" objtype="site" objname="left_lower_touch">
      <config key="nchannel" value="3" />
      <config key="size" value="4 4" />
      <config key="fov" value="110 85" />
      <config key="gamma" value="0" />
    </plugin>
    <plugin name="right_upper_grid" plugin="mujoco.sensor.touch_grid" objtype="site" objname="right_upper_touch">
      <config key="nchannel" value="3" />
      <config key="size" value="4 4" />
      <config key="fov" value="110 85" />
      <config key="gamma" value="0" />
    </plugin>
    <plugin name="right_lower_grid" plugin="mujoco.sensor.touch_grid" objtype="site" objname="right_lower_touch">
      <config key="nchannel" value="3" />
      <config key="size" value="4 4" />
      <config key="fov" value="110 85" />
      <config key="gamma" value="0" />
    </plugin>
  </sensor>
</mujoco>